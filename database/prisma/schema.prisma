// AgroFlow data model -- PostgreSQL + PostGIS, accessed only through Prisma.
// Build order: Identity domain first, then Agriculture, then Marketplace,
// then the remaining domains as each phase of the roadmap is reached.
// Group models under comment headers even though they live in one file.
//
// Phase 2 of the implementation plan: IDENTITY + AGRICULTURE are fully
// defined below. MARKETPLACE / QUALITY / LOGISTICS / STORAGE / FINANCE /
// CHANNEL / TRUST / AI / ANALYTICS are added domain-by-domain in later
// phases (see Section 9 of the master documentation and docs/BUILD_ORDER.md)
// -- do not add speculative fields for those domains here yet.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================================================
// IDENTITY
// ============================================================================
// Role/Permission NAMES are defined once in packages/config (ROLES,
// RESOURCES, ACTIONS, DEFAULT_ROLE_PERMISSIONS) and are seeded into these
// tables by prisma/seed.ts -- the seed script is the only writer of Role
// and Permission rows outside of an Admin-only management UI.

model User {
  id                 String    @id @default(uuid())
  phoneNumber        String    @unique @map("phone_number")
  fullName           String    @map("full_name")
  email              String?   @unique
  passwordHash       String?   @map("password_hash")
  preferredLanguage  String    @default("sw") @map("preferred_language") // "en" | "sw"
  preferredChannel   String    @default("APP") @map("preferred_channel")
  regionId           String?   @map("region_id") // RegionName from @agroflow/config
  isVerified         Boolean   @default(false) @map("is_verified")
  isActive           Boolean   @default(true) @map("is_active")

  roles              UserRole[]
  roleRequests       RoleRequest[]        @relation("RoleRequestApplicant")
  reviewedRoleRequests RoleRequest[]      @relation("RoleRequestReviewer")
  farms              Farm[]
  otpCodes           OtpCode[]
  refreshTokens      RefreshToken[]
  demandOrders       DemandOrder[]
  purchaseOrdersAsBuyer  PurchaseOrder[] @relation("PurchaseOrdersAsBuyer")
  purchaseOrdersAsSeller PurchaseOrder[] @relation("PurchaseOrdersAsSeller")
  qualityInspections     QualityInspection[]
  shipmentsAsTransporter Shipment[]
  warehouses             Warehouse[]
  payments               Payment[]
  reviewsWritten         Review[]              @relation("ReviewAuthor")
  reviewsReceived        Review[]              @relation("ReviewSubject")
  disputesRaised         Dispute[]             @relation("DisputeRaisedBy")
  disputesResolved       Dispute[]             @relation("DisputeResolvedBy")
  trustScore             TrustScore?
  agentAssistedActionsAsAgent  AgentAssistedAction[] @relation("AgentAssistedActionAgent")
  agentAssistedActionsAsSubject AgentAssistedAction[] @relation("AgentAssistedActionFarmer")
  auditLogs              AuditLog[]
  settlements            Settlement[]
  inventoryLots          Inventory[]
  storageBookings        StorageBooking[]

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([regionId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // RoleName from @agroflow/config, e.g. "FARMER"
  description String?

  permissions RolePermission[]
  userRoles   UserRole[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // "<resource>:<action>", e.g. "farm:create"
  resource    String
  action      String
  description String?

  roles       RolePermission[]

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([resource, action])
  @@map("permissions")
}

// Explicit join model (rather than an implicit m2m) so seed runs are
// idempotent and auditable.
model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  // Optional scoping -- e.g. a WAREHOUSE_MANAGER's assigned warehouse id.
  // Kept as an untyped string now; gains a real FK once the Storage domain
  // (Warehouse model) lands.
  scopeId   String?  @map("scope_id")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, roleId, scopeId])
  @@index([userId])
  @@map("user_roles")
}

// Registration no longer lets a user self-select a Role (security
// hardening -- see apps/api/src/services/auth/index.ts). Instead a user
// requests a role after registering; an ADMIN (role:approve permission)
// reviews the request and, on approval, a UserRole row is written.
// reviewedByUserId + reviewedAt double as the approval/rejection log --
// a richer generic AuditLog model lands in a later phase.
enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RoleRequest {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  requestedRole    String            @map("requested_role") // RoleName from @agroflow/config
  scopeId          String?           @map("scope_id") // e.g. a WAREHOUSE_MANAGER's warehouse id
  status           RoleRequestStatus @default(PENDING)
  reviewedByUserId String?           @map("reviewed_by_user_id")
  reviewedAt       DateTime?         @map("reviewed_at")
  rejectionReason  String?           @map("rejection_reason")

  user             User              @relation("RoleRequestApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?             @relation("RoleRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("role_requests")
}

// Auth: OTP for phone-based login (field roles) and refresh tokens for
// session management (apps/api auth/ -- Phase 3).
model OtpCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("otp_codes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================================
// AGRICULTURE
// ============================================================================

model Farm {
  id              String   @id @default(uuid())
  ownerId         String   @map("owner_id")
  name            String
  regionId        String   @map("region_id") // RegionName from @agroflow/config
  district        String?
  ward            String?
  village         String?
  // PostGIS point for proximity matching (nearest buyer/warehouse/transporter).
  // Prisma has no native geography type, so it's declared Unsupported and
  // read/written via $queryRaw in the repository layer (apps/api, Phase 3+).
  location        Unsupported("geography(Point,4326)")?
  sizeHectares    Float?   @map("size_hectares")

  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  farmCrops       FarmCrop[]
  produceListings ProduceListing[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([regionId])
  @@map("farms")
}

model Crop {
  id             String   @id @default(uuid())
  name           String   @unique // CropName from @agroflow/config, e.g. "MAIZE"
  varietyName    String?  @map("variety_name")
  defaultUnit    String   @map("default_unit") // UnitName from @agroflow/config

  farmCrops       FarmCrop[]
  produceListings ProduceListing[]
  demandOrders    DemandOrder[]
  inventoryLots   Inventory[]

  createdAt      DateTime @default(now()) @map("created_at")

  @@map("crops")
}

model FarmCrop {
  id                   String    @id @default(uuid())
  farmId               String    @map("farm_id")
  cropId               String    @map("crop_id")
  plantedAreaHectares  Float?    @map("planted_area_hectares")
  expectedHarvestDate  DateTime? @map("expected_harvest_date")

  farm                 Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop                 Crop      @relation(fields: [cropId], references: [id], onDelete: Restrict)

  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([farmId])
  @@index([cropId])
  @@map("farm_crops")
}

enum ProduceListingStatus {
  DRAFT
  PUBLISHED
  MATCHED
  SOLD
  EXPIRED
  WITHDRAWN
}

model ProduceListing {
  id               String                @id @default(uuid())
  farmId           String                @map("farm_id")
  cropId           String                @map("crop_id")
  quantity         Float
  unit             String // UnitName from @agroflow/config
  qualityGrade     String?               @map("quality_grade") // QualityGradeName
  pricePerUnit     Float?                @map("price_per_unit")
  currency         String                @default("TZS")
  status           ProduceListingStatus  @default(DRAFT)
  availableFrom    DateTime              @map("available_from")
  images           String[]              @default([])
  createdByChannel String                @default("APP") @map("created_by_channel") // ChannelName

  farm             Farm                  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop             Crop                  @relation(fields: [cropId], references: [id], onDelete: Restrict)
  matches          Match[]
  orderItems       OrderItem[]
  qualityInspections QualityInspection[]

  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([farmId])
  @@index([cropId])
  @@index([status])
  @@map("produce_listings")
}

// ============================================================================
// MARKETPLACE
// ============================================================================
// Phase 8 scope: DemandOrder, Match, PurchaseOrder, OrderItem -- the core
// buy loop (buyer posts demand -> proposes a match against a published
// ProduceListing -> the listing's farm owner approves -> a PurchaseOrder
// is created automatically). SupplyOffer and Negotiation (Section 9's
// full Marketplace entity list) are deferred to a later refinement --
// this MVP loop doesn't need a separate offer/negotiation entity yet,
// since a Match proposal already carries the offered quantity/price.

enum DemandOrderStatus {
  OPEN
  MATCHED
  FULFILLED
  CANCELLED
  EXPIRED
}

model DemandOrder {
  id               String            @id @default(uuid())
  buyerId          String            @map("buyer_id")
  cropId           String            @map("crop_id")
  quantity         Float
  unit             String // UnitName from @agroflow/config
  qualityGrade     String?           @map("quality_grade") // QualityGradeName
  maxPricePerUnit  Float?            @map("max_price_per_unit")
  currency         String            @default("TZS")
  regionId         String?           @map("region_id") // delivery region, RegionName
  neededBy         DateTime          @map("needed_by")
  status           DemandOrderStatus @default(OPEN)

  buyer            User              @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  crop             Crop              @relation(fields: [cropId], references: [id], onDelete: Restrict)
  matches          Match[]

  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([buyerId])
  @@index([cropId])
  @@index([status])
  @@map("demand_orders")
}

enum MatchStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Match {
  id                  String       @id @default(uuid())
  demandOrderId       String       @map("demand_order_id")
  produceListingId    String       @map("produce_listing_id")
  matchedQuantity     Float        @map("matched_quantity")
  proposedPricePerUnit Float?      @map("proposed_price_per_unit")
  status              MatchStatus  @default(PROPOSED)

  demandOrder         DemandOrder     @relation(fields: [demandOrderId], references: [id], onDelete: Cascade)
  produceListing      ProduceListing  @relation(fields: [produceListingId], references: [id], onDelete: Cascade)
  purchaseOrder       PurchaseOrder?

  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  @@index([demandOrderId])
  @@index([produceListingId])
  @@index([status])
  @@map("matches")
}

enum PurchaseOrderStatus {
  PENDING
  CONFIRMED
  IN_FULFILLMENT
  DELIVERED
  PAID
  CANCELLED
  DISPUTED
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  matchId     String              @unique @map("match_id")
  buyerId     String              @map("buyer_id")
  sellerId    String              @map("seller_id") // the produce listing's farm owner
  totalAmount Float               @map("total_amount")
  currency    String              @default("TZS")
  status      PurchaseOrderStatus @default(PENDING)

  match       Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  buyer       User       @relation("PurchaseOrdersAsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller      User       @relation("PurchaseOrdersAsSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  items       OrderItem[]
  shipment    Shipment?
  payment     Payment?
  reviews     Review[]
  disputes    Dispute[]
  settlement  Settlement?
  invoice     Invoice?
  storageBookings StorageBooking[]

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("purchase_orders")
}

model OrderItem {
  id                String   @id @default(uuid())
  purchaseOrderId   String   @map("purchase_order_id")
  produceListingId  String   @map("produce_listing_id")
  quantity          Float
  unit              String
  pricePerUnit      Float    @map("price_per_unit")
  subtotal          Float

  purchaseOrder     PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  produceListing    ProduceListing @relation(fields: [produceListingId], references: [id], onDelete: Restrict)

  createdAt         DateTime @default(now()) @map("created_at")

  @@index([purchaseOrderId])
  @@map("order_items")
}

// ============================================================================
// QUALITY
// ============================================================================
// Phase 9 scope: QualityInspection only, with images stored inline as a
// string array (same pattern as ProduceListing.images) rather than a
// separate InspectionImage table -- keeps this phase's surface area
// proportionate to what the API/web actually expose. QualityCertificate
// (a formal document issued off the back of one or more inspections) is
// deferred to whenever certification/export flows are built.
//
// Inspections are NOT farm/listing-ownership scoped like Agriculture
// domain models -- an inspector (typically an AGGREGATOR) can inspect
// any published listing they're handling; quality_inspection:create is
// a capability check only, with no additional per-instance ownership
// rule the way farms/produce-listings have.

model QualityInspection {
  id               String   @id @default(uuid())
  produceListingId String   @map("produce_listing_id")
  inspectorId      String   @map("inspector_id")
  grade            String // QualityGradeName from @agroflow/config
  notes            String?
  images           String[] @default([])
  inspectedAt      DateTime @default(now()) @map("inspected_at")

  produceListing   ProduceListing @relation(fields: [produceListingId], references: [id], onDelete: Cascade)
  inspector        User           @relation(fields: [inspectorId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now()) @map("created_at")

  @@index([produceListingId])
  @@index([inspectorId])
  @@map("quality_inspections")
}

// ============================================================================
// LOGISTICS
// ============================================================================
// Phase 10 scope: Shipment only, modeled as a lightweight "job board" --
// a buyer requests a shipment for an existing PurchaseOrder, any
// TRANSPORTER can claim an unclaimed one, then update its status
// through to delivered. Vehicle/route optimization entities are
// deferred until there's an actual dispatch-planning feature to justify
// them.

enum ShipmentStatus {
  PENDING_PICKUP
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Shipment {
  id                String         @id @default(uuid())
  purchaseOrderId   String         @unique @map("purchase_order_id")
  transporterId     String?        @map("transporter_id")
  deliveryLocation  String         @map("delivery_location")
  status            ShipmentStatus @default(PENDING_PICKUP)
  scheduledPickupAt DateTime?      @map("scheduled_pickup_at")
  pickedUpAt        DateTime?      @map("picked_up_at")
  deliveredAt       DateTime?      @map("delivered_at")

  purchaseOrder     PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  transporter       User?          @relation(fields: [transporterId], references: [id], onDelete: SetNull)

  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@index([transporterId])
  @@index([status])
  @@map("shipments")
}

// ============================================================================
// STORAGE
// ============================================================================
// Phase 11 scope: Warehouse only -- a directory of storage facilities a
// WAREHOUSE_MANAGER registers and maintains capacity/utilization for.
// StorageBooking (linking a PurchaseOrder or ProduceListing to a
// warehouse for a holding period) is deferred until Logistics/Finance
// integrate with it -- a booking without a fulfillment flow around it
// isn't useful on its own yet.

model Warehouse {
  id                 String   @id @default(uuid())
  ownerId            String   @map("owner_id") // the WAREHOUSE_MANAGER who registered it
  name               String
  regionId           String   @map("region_id") // RegionName from @agroflow/config
  district           String?
  address            String?
  capacityTonnes     Float?   @map("capacity_tonnes")
  currentUtilization Float?   @map("current_utilization") // tonnes currently in use

  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  inventoryLots      Inventory[]
  storageBookings    StorageBooking[]

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([regionId])
  @@map("warehouses")
}

// ============================================================================
// FINANCE
// ============================================================================
// Phase 12 scope: Payment only, provider-agnostic. No live AzamPay/
// Selcom/MalipoPay API calls are wired in here (per the project's
// pattern of skipping paid third-party integrations until ready to
// upgrade) -- "initiate" records intent, and a generic webhook receiver
// (apps/api's channelAuth-style shared-secret pattern) is where a real
// gateway's confirmation would land. Swapping in a real provider later
// means adding the outbound API call in services/payments and pointing
// that provider's webhook at the existing receiver -- this schema and
// the PurchaseOrderStatus transition it drives don't need to change.

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(uuid())
  purchaseOrderId   String        @unique @map("purchase_order_id")
  payerId           String        @map("payer_id")
  amount            Float
  currency          String        @default("TZS")
  provider          String // MobileMoneyProvider from @agroflow/config
  providerReference String?       @map("provider_reference") // external transaction id, set on confirm
  status            PaymentStatus @default(PENDING)
  initiatedAt       DateTime      @default(now()) @map("initiated_at")
  confirmedAt       DateTime?     @map("confirmed_at")

  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  payer             User          @relation(fields: [payerId], references: [id], onDelete: Cascade)
  transactions      PaymentTransaction[]
  refunds           Refund[]

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([payerId])
  @@index([status])
  @@map("payments")
}

// ============================================================================
// TRUST
// ============================================================================
// Phase 3 scope: a lightweight reputation layer on top of the Marketplace
// domain. Review is buyer<->seller feedback left after a PurchaseOrder;
// Dispute is raised against a PurchaseOrder (mirrors PurchaseOrderStatus's
// existing DISPUTED value); TrustScore is a rolling per-user aggregate
// that services/ai reads when ranking match recommendations.

model Review {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  authorId        String        @map("author_id")
  subjectId       String        @map("subject_id") // the user being reviewed
  rating          Int // 1-5
  comment         String?

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  author          User          @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject         User          @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([purchaseOrderId, authorId])
  @@index([subjectId])
  @@map("reviews")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Dispute {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("purchase_order_id")
  raisedById       String        @map("raised_by_id")
  reason           String
  status           DisputeStatus @default(OPEN)
  resolutionNotes  String?       @map("resolution_notes")
  resolvedById     String?       @map("resolved_by_id")
  resolvedAt       DateTime?     @map("resolved_at")

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  raisedBy         User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)
  resolvedBy       User?         @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([purchaseOrderId])
  @@index([status])
  @@map("disputes")
}

model TrustScore {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  score            Float    @default(50) // 0-100, baseline 50 for a new account
  completedOrders  Int      @default(0) @map("completed_orders")
  disputesFiled    Int      @default(0) @map("disputes_filed")
  disputesAgainst  Int      @default(0) @map("disputes_against")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("trust_scores")
}

// ============================================================================
// CHANNEL / COMMUNICATION
// ============================================================================
// USSDSession/SMSMessage/WhatsAppMessage are keyed by phone number, not a
// User relation -- a field-role person can interact over USSD/SMS before
// (or without ever) completing registration, matching how those channels
// actually work. AgentAssistedAction logs a VILLAGE_AGENT acting on
// behalf of a farmer (see services/auth's "agent-assisted login" note).

model USSDSession {
  id              String    @id @default(uuid())
  sessionId       String    @unique @map("session_id") // id assigned by the USSD aggregator
  phoneNumber     String    @map("phone_number")
  currentMenu     String    @map("current_menu")
  context         Json?
  startedAt       DateTime  @default(now()) @map("started_at")
  lastActivityAt  DateTime  @updatedAt @map("last_activity_at")
  endedAt         DateTime? @map("ended_at")

  @@index([phoneNumber])
  @@map("ussd_sessions")
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model SMSMessage {
  id                String           @id @default(uuid())
  phoneNumber       String           @map("phone_number")
  direction         MessageDirection @default(OUTBOUND)
  body              String
  status            MessageStatus    @default(QUEUED)
  providerMessageId String?          @map("provider_message_id")

  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([phoneNumber])
  @@index([status])
  @@map("sms_messages")
}

model WhatsAppMessage {
  id                String           @id @default(uuid())
  phoneNumber       String           @map("phone_number")
  direction         MessageDirection @default(OUTBOUND)
  body              String
  templateName      String?          @map("template_name")
  status            MessageStatus    @default(QUEUED)
  providerMessageId String?          @map("provider_message_id")

  createdAt         DateTime         @default(now()) @map("created_at")

  @@index([phoneNumber])
  @@index([status])
  @@map("whatsapp_messages")
}

model AgentAssistedAction {
  id         String   @id @default(uuid())
  agentId    String   @map("agent_id")
  farmerId   String   @map("farmer_id")
  actionType String   @map("action_type") // e.g. "REGISTER", "CREATE_LISTING", "LOGIN"
  metadata   Json?

  agent      User     @relation("AgentAssistedActionAgent", fields: [agentId], references: [id], onDelete: Cascade)
  farmer     User     @relation("AgentAssistedActionFarmer", fields: [farmerId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([agentId])
  @@index([farmerId])
  @@map("agent_assisted_actions")
}

// ============================================================================
// ADMIN
// ============================================================================
// Generic action log for admin-sensitive operations (dispute resolution,
// role-request review, etc). RoleRequest's reviewedByUserId/reviewedAt
// (Phase 1) remains the durable record for that specific flow; AuditLog
// is the general-purpose trail other admin actions write to from here on.

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  action     String // e.g. "dispute:resolve", "role_request:approve"
  entityType String   @map("entity_type") // e.g. "Dispute", "RoleRequest"
  entityId   String?  @map("entity_id")
  metadata   Json?

  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// FINANCE (extended)
// ============================================================================
// PaymentTransaction is a granular log under a Payment (retries/provider
// callbacks); Settlement is the platform's payout to a seller once a
// Payment is CONFIRMED; Invoice/Refund round out the finance trail.
// All still provider-agnostic, same rationale as Payment above.

enum PaymentTransactionType {
  INITIATION
  CALLBACK
  REVERSAL
}

model PaymentTransaction {
  id                String                  @id @default(uuid())
  paymentId         String                  @map("payment_id")
  type              PaymentTransactionType
  status            PaymentStatus
  providerReference String?                 @map("provider_reference")
  rawPayload        Json?                   @map("raw_payload")

  payment           Payment                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt         DateTime                @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("payment_transactions")
}

enum SettlementStatus {
  PENDING
  PAID
  FAILED
}

model Settlement {
  id              String           @id @default(uuid())
  purchaseOrderId String           @unique @map("purchase_order_id")
  sellerId        String           @map("seller_id")
  amount          Float
  currency        String           @default("TZS")
  status          SettlementStatus @default(PENDING)
  paidAt          DateTime?        @map("paid_at")

  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  seller          User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([status])
  @@map("settlements")
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

model Invoice {
  id              String        @id @default(uuid())
  purchaseOrderId String        @unique @map("purchase_order_id")
  invoiceNumber   String        @unique @map("invoice_number")
  amount          Float
  currency        String        @default("TZS")
  status          InvoiceStatus @default(ISSUED)
  issuedAt        DateTime      @default(now()) @map("issued_at")
  dueAt           DateTime?     @map("due_at")

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("invoices")
}

enum RefundStatus {
  PENDING
  PROCESSED
  REJECTED
}

model Refund {
  id          String       @id @default(uuid())
  paymentId   String       @map("payment_id")
  amount      Float
  reason      String?
  status      RefundStatus @default(PENDING)
  processedAt DateTime?    @map("processed_at")

  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("refunds")
}

// ============================================================================
// AGGREGATION
// ============================================================================
// Inventory is a bulk lot an AGGREGATOR (or WAREHOUSE_MANAGER) holds after
// consolidating produce from multiple listings -- services/aggregation's
// core entity.

model Inventory {
  id          String     @id @default(uuid())
  ownerId     String     @map("owner_id")
  warehouseId String?    @map("warehouse_id")
  cropId      String     @map("crop_id")
  quantity    Float
  unit        String // UnitName from @agroflow/config

  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  crop        Crop       @relation(fields: [cropId], references: [id], onDelete: Restrict)

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([warehouseId])
  @@map("inventory")
}

// ============================================================================
// STORAGE (extended)
// ============================================================================
// StorageBooking -- deferred at schema-inception time until Logistics and
// Finance had something to integrate it with (see the Warehouse model's
// comment above); services/logistics now owns booking warehouse capacity
// against a PurchaseOrder.

enum StorageBookingStatus {
  BOOKED
  ACTIVE
  COMPLETED
  CANCELLED
}

model StorageBooking {
  id               String                @id @default(uuid())
  warehouseId      String                @map("warehouse_id")
  purchaseOrderId  String?               @map("purchase_order_id")
  bookedById       String                @map("booked_by_id")
  quantityTonnes   Float                 @map("quantity_tonnes")
  startDate        DateTime              @map("start_date")
  endDate          DateTime?             @map("end_date")
  status           StorageBookingStatus  @default(BOOKED)

  warehouse        Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  bookedBy         User                  @relation(fields: [bookedById], references: [id], onDelete: Cascade)

  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([warehouseId])
  @@index([status])
  @@index([bookedById])
  @@map("storage_bookings")
}

