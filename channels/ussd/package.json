{
  "name": "@agroflow/channel-ussd",
  "version": "0.1.0",
  "description": "USSD session-driven service (Section 10). Deployable separately from the main API -- sub-second session timeouts, different scaling profile.",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agroflow/types": "workspace:*",
    "@agroflow/config": "workspace:*",
    "express": "^4.19.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0"
  }
}
