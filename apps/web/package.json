{
  "name": "@agroflow/web",
  "version": "0.1.0",
  "description": "AgroFlow web console -- React + Vite. Ops dashboard for buyers, aggregators, warehouse managers, transporter dispatch and admins. Farmers can sign in here too (same account/backend) but the web app is not the primary channel built for them.",
  "main": "src/main.tsx",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agroflow/types": "workspace:*",
    "@agroflow/validation": "workspace:*",
    "@agroflow/config": "workspace:*",
    "@agroflow/api-client": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "@tanstack/react-query": "^5.53.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.2",
    "typescript": "^5.5.4",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20"
  }
}
