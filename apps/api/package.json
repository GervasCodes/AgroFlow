{
  "name": "@agroflow/api",
  "version": "0.1.0",
  "description": "AgroFlow backend -- Node.js + Express. Single API shared by web, mobile, USSD, SMS, WhatsApp and agent-assisted channels.",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agroflow/config": "workspace:*",
    "@agroflow/types": "workspace:*",
    "@agroflow/validation": "workspace:*",
    "@agroflow/database": "workspace:*",
    "@prisma/client": "^5.19.1",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.15"
  }
}
